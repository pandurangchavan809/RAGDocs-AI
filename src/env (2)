# ============================================================================
# Documentation Assistant -- centralized configuration
# Every runtime value the app uses lives here. Nothing below should ever
# need a matching hardcoded value anywhere in the Python code.
# ============================================================================

# ----------------------------------------------------------------------------
# ROUTES -- one block per server you actually run.
# <NAME> is a ROLE label (PRIMARY / SECONDARY / LOCAL), never a model name --
# when the model behind a route changes, edit the 3-4 lines below it; the
# name itself never changes, so no task chain or code ever needs editing.
#
#   ROUTE_<NAME>_URL      required
#   ROUTE_<NAME>_KIND     required: generate | openai_chat | embed | rerank | vlm_extract
#   ROUTE_<NAME>_MODEL    required only for KIND=openai_chat
#   ROUTE_<NAME>_TIMEOUT  optional, seconds (default 120)
# ----------------------------------------------------------------------------

# -- LLM routes --
ROUTE_LLM_PRIMARY_URL=http://10.47.0.10:9000/v1/chat/completions
ROUTE_LLM_PRIMARY_KIND=openai_chat
ROUTE_LLM_PRIMARY_MODEL=qwen3.6-nvfp4
ROUTE_LLM_PRIMARY_TIMEOUT=120
# Suppresses Qwen3.6's <think> reasoning mode at the chat-template level --
# the actual fix for thinking-trace leakage (llm_client.py's </think>
# strip is now just a fallback safety net underneath this).
ROUTE_LLM_PRIMARY_ENABLE_THINKING=false

ROUTE_LLM_SECONDARY_URL=http://10.47.0.10:8080/generate
ROUTE_LLM_SECONDARY_KIND=generate
ROUTE_LLM_SECONDARY_TIMEOUT=90

ROUTE_LLM_LOCAL_URL=http://localhost:5001/generate
ROUTE_LLM_LOCAL_KIND=generate
ROUTE_LLM_LOCAL_TIMEOUT=60

# -- Embedding routes --
ROUTE_EMBED_PRIMARY_URL=http://10.47.0.10:8001/embed
ROUTE_EMBED_PRIMARY_KIND=embed
ROUTE_EMBED_PRIMARY_TIMEOUT=60

ROUTE_EMBED_LOCAL_URL=http://localhost:5002/embed
ROUTE_EMBED_LOCAL_KIND=embed
ROUTE_EMBED_LOCAL_TIMEOUT=30

# -- Reranker routes --
ROUTE_RERANK_PRIMARY_URL=http://10.47.0.10:8002/rerank
ROUTE_RERANK_PRIMARY_KIND=rerank
ROUTE_RERANK_PRIMARY_TIMEOUT=60

ROUTE_RERANK_LOCAL_URL=http://localhost:5003/rerank
ROUTE_RERANK_LOCAL_KIND=rerank
ROUTE_RERANK_LOCAL_TIMEOUT=30

# -- Future capability, not active until uncommented + given a real URL --
# ROUTE_VLM_PRIMARY_URL=http://10.47.0.10:8005/extract
# ROUTE_VLM_PRIMARY_KIND=vlm_extract
# ROUTE_VLM_PRIMARY_TIMEOUT=120

# ----------------------------------------------------------------------------
# TASK -> ROUTE CHAINS
# Ordered, comma-separated. First reachable route wins; only if every route
# in a task's chain fails does that task report itself unavailable.
# ----------------------------------------------------------------------------
TASK_RAG_ANSWER_ROUTES=LLM_PRIMARY,LLM_SECONDARY,LLM_LOCAL
TASK_AGENT_EVAL_ROUTES=LLM_SECONDARY,LLM_LOCAL
TASK_ACRONYM_RESOLVE_ROUTES=LLM_SECONDARY,LLM_LOCAL
TASK_SESSION_SUMMARY_ROUTES=LLM_LOCAL
# Query rewrite/classify step (new) -- deliberately never includes
# LLM_PRIMARY (Qwen3.6). Qwen3.6's reasoning overhead is reserved for the
# final answer only; every other internal step stays fast/cheap.
TASK_QUERY_REWRITE_ROUTES=LLM_SECONDARY,LLM_LOCAL

TASK_EMBEDDING_ROUTES=EMBED_PRIMARY,EMBED_LOCAL
TASK_RERANK_ROUTES=RERANK_PRIMARY,RERANK_LOCAL

# Future, add alongside ROUTE_VLM_PRIMARY above when ready:
# TASK_IMAGE_EXTRACT_ROUTES=VLM_PRIMARY

# ----------------------------------------------------------------------------
# Retrieval pipeline
# ----------------------------------------------------------------------------
CANDIDATES=30
TOP_K=8
THRESHOLD=0
QDRANT_DB_PATH=qdrant_db_vlm
QDRANT_COLLECTION=rag_chunks_vlm

# ----------------------------------------------------------------------------
# Generation limits
# ----------------------------------------------------------------------------
MAX_CHUNK_CHARS=1200
MAX_CONTEXT_CHARS=18000
MAX_NEW_TOKENS=2048
LLM_TEMPERATURE=0.2

# Separate, larger budget for the final RAG_ANSWER call only (Qwen3.6's
# <think> reasoning trace consumes tokens before the real answer even
# starts -- MAX_NEW_TOKENS above is now the shared default for the
# cheaper/faster tasks: eval, query rewrite, acronym resolution, summary).
RAG_ANSWER_MAX_NEW_TOKENS=6000

# ----------------------------------------------------------------------------
# Domain guardrail -- ONE definition of "in scope", shared by rag.py's
# system prompt and agent.py's query-classification step. Change the
# description here; both places pick it up automatically.
# ----------------------------------------------------------------------------
DOMAIN_DESCRIPTION=automotive and semiconductor technology -- chipsets, SoCs, embedded systems, ADAS, connectivity, and closely adjacent technical topics (e.g. IoT)
OUT_OF_DOMAIN_MESSAGE=I'm scoped to automotive and semiconductor documentation questions, so I can't help with general knowledge questions like that.

# Named vector fields for multi-vector retrieval (dense is auto-detected
# from the collection; these two are used only if present).
SPARSE_VECTOR_NAME=sparse
COLBERT_VECTOR_NAME=colbert

# ----------------------------------------------------------------------------
# Acronym / HITL
# ----------------------------------------------------------------------------
ACRONYM_CONFIDENCE_AUTO=90
ACRONYM_CONFIDENCE_CHOICE=60
HITL_COUNTDOWN_SECONDS=30
ACRONYMS_SYS_PATH=acronyms/clean_35.json
ACRONYMS_USER_PATH=acc.json

# ----------------------------------------------------------------------------
# Agent
# ----------------------------------------------------------------------------
AGENT_MAX_ITERATIONS=2
